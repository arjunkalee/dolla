# Optional. Overrides the salted PIN hash in lib/auth.ts. Leave unset to use that hash.
# DOLLA_PIN=
DOLLA_SESSION_SECRET=change-me-to-a-long-random-string

# Durable store on Vercel (pick Turso OR Upstash/KV). Writes refuse without one.
# Turso:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# Vercel KV / Upstash Redis (Storage marketplace usually injects KV_*):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Upstash REST aliases (also accepted by lib/store.ts):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# In-app assistant. The key stays on the server. Never commit a real key.
# ANTHROPIC_API_KEY=
# Optional. Defaults to Claude Sonnet 5.5 (claude-sonnet-5-5).
# DOLLA_AI_MODEL=claude-sonnet-5-5
# Monthly assistant cap in USD, America/Chicago. Defaults to 10.
# DOLLA_AI_MONTHLY_CAP_USD=10
